// 이 파일을 rethink-config.json 으로 복사한 뒤 hostname과 homeassistant.mqtt_url 을
// 실제 값으로 채우세요. rethink는 이 형식(JSON + 주석, .jsonc)을 그대로 읽습니다.
// 스키마 출처: anszom/rethink 원본 config.jsonc (rethink-vendor/config.jsonc 참고)
{
  // IP 주소는 안 됨. 우리 구성에서는 어떤 이름이든 상관없음 (advertise_requested_host가
  // 켜져 있으면, 기기가 자기가 원래 쓰던 LG 이름을 그대로 쓰게 되므로 이 값은
  // rethink 관리 웹 UI 표시용 정도로만 쓰인다).
  "hostname": "rethink.lan",

  // 리다이렉트로만 붙는(SoftAP 재설정 없이 DNAT로 넘어온) 기기를 위한 필수 옵션.
  // 켜두면 /route가 기기가 원래 요청한 이름을 그대로 돌려준다.
  "advertise_requested_host": true,

  "homeassistant": {
    "mqtt_url": "mqtt://192.168.0.X:1883",
    "discovery_prefix": "homeassistant",
    "rethink_prefix": "rethink",
    "mqtt_user": "",
    "mqtt_pass": ""
  },

  "ca_key_file": "ca.key",
  "ca_cert_file": "ca.cert",

  // 기기 네이티브 기대값(443/8883) 그대로 사용. 다른 값으로 바꾸면 리다이렉트
  // 이후 기기가 광고받은 새 포트로 옮겨가면서 우리 WinDivert 필터가 놓칠 수 있다.
  "https_port": 443,
  "mqtts_port": 8883,

  // 로컬 디버깅용, ThinQ2 기기는 안 씀
  "mqtt_port": 1884,

  "thinq1_https_port": 46030,
  "thinq1_port": 47878,

  "management_port": 44401,

  "bridge": {
    "storage_path": "./state"
  },

  "log": ["status", "incoming", "HTTPS", "publish", "MGMT"]
}
